# Optional: set these before first start to bootstrap an administrator.
# If omitted, the first person to sign up becomes the administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pi provider API credentials. For subscription auth, run pi /login in the container.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional
AIDLC_PORT=3000
COOKIE_SECURE=0
